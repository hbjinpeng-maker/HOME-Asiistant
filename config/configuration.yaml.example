# Home Assistant 基础配置示例
# 首次启动后，HA 会自动生成 configuration.yaml
# 如需远程访问或反向代理，可参考以下 http 配置

default_config:

# 若使用 Nginx / Cloudflare Tunnel 等反向代理，取消注释并修改:
# http:
#   use_x_forwarded_for: true
#   trusted_proxies:
#     - 127.0.0.1
#     - ::1
#     - 172.16.0.0/12

# 日志级别（排查问题时改为 debug）
logger:
  default: info
